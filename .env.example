# ── Firebase klien ────────────────────────────────────────────────────────
# Dari Firebase Console → Project settings → General → Your apps → Web app.
# Nilai NEXT_PUBLIC_* memang terlihat di browser; pengamanan ada di
# Security Rules (lihat firestore.rules), bukan di kerahasiaan nilai ini.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server saja) ──────────────────────────────────────────
# Dari Project settings → Service accounts → Generate new private key.
# JANGAN diberi awalan NEXT_PUBLIC_: ini kunci penuh ke project.
# FIREBASE_PRIVATE_KEY ditulis dalam satu baris dengan \n literal, di dalam
# tanda kutip ganda.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ── Midtrans (payment gateway) ────────────────────────────────────
# Dari dashboard Midtrans, Settings, Access Keys.
#
# Sandbox atau produksi TIDAK diatur di sini: ditentukan dari awalan kuncinya
# sendiri. Kunci sandbox berawalan "SB-", kunci produksi tidak. Keduanya harus
# dari lingkungan yang sama; server sandbox dengan klien produksi (atau
# sebaliknya) membuat setiap transaksi gagal dengan pesan yang tidak menunjuk
# ke mana pun, dan konfigurasinya sengaja menolak berjalan kalau begitu.
#
# Kalau kedua nilai ini kosong, tombol bayar tidak muncul dan jalur transfer
# manual tetap berjalan seperti sebelumnya.
#
# Setelah dipasang, daftarkan juga URL notifikasinya di dashboard Midtrans,
# menu Settings lalu Payment, kolom "Payment Notification URL":
#   https://haribaik.seawise.id/api/bayar/notifikasi
#
# Sandbox dan produksi punya dashboard terpisah dan pengaturannya tidak saling
# menyalin, jadi URL itu harus didaftarkan di dashboard yang kuncinya dipakai.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
