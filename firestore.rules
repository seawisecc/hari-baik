rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Role admin datang dari custom claim yang di-set lewat Admin SDK di server,
    // bukan dari field dokumen, supaya tidak bisa diubah dari klien.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Field yang menentukan akses dan penagihan. Hanya server (Admin SDK,
    // yang melewati rules) dan admin yang boleh menyentuhnya. Kalau klien
    // bisa menulis trialEndsAt, siapa pun bisa memberi dirinya trial abadi.
    function protectedFields() {
      return [
        'role',
        'subscriptionStatus',
        'subscriptionExpiresAt',
        'trialEndsAt',
        'email',
        'createdAt'
      ];
    }

    // True bila update TIDAK mengubah satu pun field terlindungi.
    function keepsProtectedFields() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(protectedFields().toSet());
    }

    match /users/{uid} {
      allow get, list: if isOwner(uid) || isAdmin();

      // Klien tidak pernah membuat dokumen profil. Pembuatannya lewat
      // /api/auth/bootstrap yang memakai Admin SDK, supaya masa trial
      // ditentukan server dan tidak bisa dikarang dari browser.
      allow create: if false;

      // Pengguna boleh mengubah profilnya sendiri: nama, tanggal lahir,
      // nomor HP, dan field wariga turunannya. Tanggal lahir sengaja TIDAK
      // dikunci, karena salah ketik itu wajar dan mengubahnya tidak memberi
      // keuntungan apa pun selain perhitungan yang benar.
      allow update: if isAdmin() || (isOwner(uid) && keepsProtectedFields());

      allow delete: if isAdmin();

      match /riwayat/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Tolak selain yang di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
