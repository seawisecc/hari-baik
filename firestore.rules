rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Role admin datang dari custom claim yang di-set lewat Admin SDK di server,
    // bukan dari field dokumen, supaya tidak bisa diubah dari klien.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Kunci yang berubah pada satu update.
    function diubah() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Satu-satunya field yang boleh disentuh klien. Ditulis sebagai daftar
    // yang diizinkan, bukan daftar yang dilarang: field baru yang ditambahkan
    // nanti otomatis tertutup sampai sengaja dibuka di sini.
    function fieldKlien() {
      return [
        'nama',
        'phoneNumber',
        'keluarga',
        'onboardingComplete',
        'tanggalLahir',
        'saptaWaraLahir',
        'pancaWaraLahir',
        'sadWaraLahir',
        'wukuLahir',
        'uripLahir',
        'uripPetemonLahir'
      ];
    }

    // Field yang menentukan akses dan penagihan: role, subscriptionStatus,
    // subscriptionExpiresAt, trialEndsAt, addOn, email, createdAt. Semuanya
    // di luar fieldKlien(), jadi sudah tertutup oleh hasOnly di bawah. Cek
    // terpisah ini sengaja dipertahankan sebagai lapis kedua: kalau suatu
    // hari ada yang menambahkan salah satunya ke fieldKlien() tanpa sadar,
    // penjaga ini masih menolaknya.
    function protectedFields() {
      return [
        'role',
        'subscriptionStatus',
        'subscriptionExpiresAt',
        'trialEndsAt',
        'addOn',
        'email',
        'createdAt'
      ];
    }

    function keepsProtectedFields() {
      return !diubah().hasAny(protectedFields().toSet());
    }

    function hanyaFieldKlien() {
      return diubah().hasOnly(fieldKlien().toSet());
    }

    // Tanggal lahir dan seluruh turunan warigannya. Sekali terisi, hanya
    // admin yang boleh mengubahnya.
    function fieldLahir() {
      return [
        'tanggalLahir',
        'saptaWaraLahir',
        'pancaWaraLahir',
        'sadWaraLahir',
        'wukuLahir',
        'uripLahir',
        'uripPetemonLahir'
      ];
    }

    function menyentuhLahir() {
      return diubah().hasAny(fieldLahir().toSet());
    }

    function lahirMasihKosong() {
      return !('tanggalLahir' in resource.data) || resource.data.tanggalLahir == null;
    }

    // Bentuk dan batas ukuran, supaya dokumen profil tidak bisa dipakai
    // sebagai tempat penyimpanan bebas oleh pemiliknya sendiri.
    function bentukProfilValid() {
      return request.resource.data.nama is string
        && request.resource.data.nama.size() <= 120
        && (request.resource.data.tanggalLahir == null || (
              request.resource.data.tanggalLahir is string
              && request.resource.data.tanggalLahir.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            ))
        && (request.resource.data.phoneNumber == null || (
              request.resource.data.phoneNumber is string
              && request.resource.data.phoneNumber.size() <= 20
            ))
        && (!('keluarga' in request.resource.data) || (
              request.resource.data.keluarga is list
              && request.resource.data.keluarga.size() <= 12
            ));
    }

    match /users/{uid} {
      allow get, list: if isOwner(uid) || isAdmin();

      // Klien tidak pernah membuat dokumen profil. Pembuatannya lewat
      // /api/auth/bootstrap yang memakai Admin SDK, supaya masa trial
      // ditentukan server dan tidak bisa dikarang dari browser.
      allow create: if false;

      // Pengguna boleh mengubah nama, nomor HP, dan daftar keluarganya kapan
      // saja. Tanggal lahir hanya boleh diisi SEKALI, saat masih kosong di
      // onboarding; sesudah itu terkunci dan perubahannya harus lewat admin.
      //
      // Alasannya bukan keamanan melainkan kepercayaan hasil: seluruh isi
      // aplikasi, dari kategori hari sampai laporan, dihitung dari tanggal
      // ini. Kalau pengguna bisa menggesernya sendiri kapan pun, tidak ada
      // yang bisa dijelaskan ketika hasil kemarin berbeda dari hasil hari
      // ini. Karena itu di onboarding tanggalnya dikonfirmasi dulu.
      allow update: if isAdmin() || (
        isOwner(uid)
        && hanyaFieldKlien()
        && keepsProtectedFields()
        && bentukProfilValid()
        && (!menyentuhLahir() || lahirMasihKosong())
      );

      allow delete: if isAdmin();
    }

    // Permintaan aktivasi. Pengguna boleh membaca miliknya sendiri supaya
    // tahu permintaannya sedang diproses, tapi tidak boleh membuat atau
    // mengubahnya dari sini: pembuatannya lewat /api/aktivasi yang mengambil
    // harga dari server, dan keputusannya hanya milik admin.
    match /aktivasi/{reqId} {
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Pesanan lewat payment gateway. Sama seperti aktivasi: pengguna boleh
    // melihat miliknya sendiri, tapi tidak ada satu pun jalan menulisnya dari
    // klien. Nominalnya dirakit server dari daftar harga, dan status lunasnya
    // hanya boleh datang dari notifikasi Midtrans yang tanda tangannya sudah
    // diperiksa. Kalau klien bisa menyentuh dokumen ini, "status: lunas"
    // tinggal diketik sendiri.
    match /pembayaran/{orderId} {
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Jejak audit. Hanya ditulis Admin SDK di server, yang melewati rules;
    // dari klien mana pun tidak ada jalan menulis, menyunting, atau
    // menghapusnya. Admin boleh membaca supaya riwayat keputusan bisa
    // ditelusuri tanpa membuka konsol Firebase.
    match /jejak/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Daftar harga. Ditulis hanya lewat Admin SDK di server (route
    // /api/admin/harga), yang memvalidasi bentuk dan batas nilainya lebih
    // dulu.
    //
    // Dibacanya juga lewat server: bacaHarga() memakai Admin SDK, yang
    // melewati rules, lalu menyaring add-on yang fiturnya belum ada dan
    // membuang email admin yang menyimpannya. Dokumen mentahnya sendiri
    // tidak dibuka untuk umum. Harganya memang publik, tapi yang publik
    // adalah versi tersaring itu, bukan isi dokumennya apa adanya.
    match /pengaturan/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Tolak selain yang di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
